+    # ------------------------------------------------------------------
+    # [S1] Confidence-gated per-request verification truncation helpers.
+    # ------------------------------------------------------------------
+
+    def _conf_pull_lengths(self, num_reqs_expected: int) -> None:
+        """[S1] Pull the latest stale confidences from the worker-side
+        speculator snapshot and compute this step's per-request verification
+        lengths.
+
+        survival = cumprod(conf) is monotonically decreasing; a request's
+        length is the longest prefix whose survival stays >= VLLM_DSPARK_CONF_MIN
+        (#47808 formula). thr <= 0 keeps every length at the static k so the
+        gate can be enabled for observation with zero truncation.
+
+        Confidences come from ``update_confidences`` (stale by one step by
+        design; confidence curves are smooth, so a one-step lag only costs a
+        suboptimal length, never correctness — truncation is still exact
+        rejection sampling).
+        """
+        if not self._conf_gate or self._conf_snapshot is None:
+            return
+        conf = self._conf_snapshot
+        n = min(conf.shape[0], num_reqs_expected)
+        lengths: dict[str, int] = {}
+        req_ids = self._conf_snapshot_req_ids
+        if req_ids is None:
+            return
+        k = self.num_spec_tokens
+        for j in range(n):
+            req_id = req_ids[j]
+            request = self.requests.get(req_id)
+            if request is None or request.is_finished():
+                continue
+            if self._conf_min <= 0.0:
+                length = k
+            else:
+                survival = np.cumprod(conf[j].astype(np.float64))
+                ok = survival >= self._conf_min
+                length = int(ok.cumsum().argmax()) + 1 if ok[0] else 1
+                length = min(max(length, 1), k)
+            lengths[req_id] = length
+        self._conf_lengths = lengths
+        self._conf_snapshot = None
+        self._conf_snapshot_req_ids = None
+
+    def update_confidences(
+        self, req_ids: list[str], confidences: Any
+    ) -> None:
+        """[S1] Entry point for the worker side (ModelRunner output pump):
+        receive the latest stale per-request confidence matrix
+        ([num_reqs, num_spec_tokens] array-like, aligned with req_ids).
+        Must be called before schedule() consumes it for the next step.
+        No-op when the gate is off."""
+        if not self._conf_gate:
+            return
+        # [S1-P2] Explicit copy: the worker-side matrix is a view into a
+        # double-buffered staging slot that gets overwritten next step;
+        # np.array(...) detaches us from that memory.
+        self._conf_snapshot = np.array(confidences, dtype=np.float32, copy=True)
+        self._conf_snapshot_req_ids = list(req_ids)
