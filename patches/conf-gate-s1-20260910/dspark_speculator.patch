+    def get_stale_confidences(self, num_reqs: int) -> np.ndarray | None:
+        """[S1] Last completed draft step's confidences, [num_reqs, k] fp32.
+
+        Stale double-buffer semantics (#47808): the scheduler consumes step
+        N-1's confidences to size step N's per-request verification lengths —
+        a one-step lag with no GPU sync. The event-level wait only blocks the
+        host until the D2H copy completes (it usually already has); it never
+        stalls the device.
