+    def compute_confidence(
+        self, head_hidden: torch.Tensor, markov_embed: torch.Tensor
+    ) -> torch.Tensor:
+        """[S1] Per-position acceptance confidence P(accept | prefix accepted).
+
+        head_hidden:  [num_sample, hidden_size] pre-norm hc_head output, i.e.
+                      the forward return value for exactly the sampled positions.
+        markov_embed: [num_sample, dspark_markov_rank] per-position Markov
+                      embedding (each sampled step's embedding for that
+                      position's request).
+        Returns fp32 sigmoid scores [num_sample, 1] -> [num_sample].
+
+        Semantics mirrored from the checkpoint reference implementation
+        (/models/inference/model.py: cat([hidden, markov_embed]) -> fp32 proj
+        -> sigmoid). Pure function: no buffer writes, no syncs, capture-safe;
+        only called when the confidence head is wired (gate on).
+        """
+        assert self.model.confidence_head is not None
+        x = torch.cat(
+            [head_hidden.to(torch.float32), markov_embed.to(torch.float32)],
+            dim=-1,
+        )
+        logits = self.model.confidence_head(x)
+        return torch.sigmoid(logits.squeeze(-1))
+
